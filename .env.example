# 環境變數設定範例
# 複製此檔案為 .env 並填入您的 API Keys

# OpenAI API Key (必須)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google API Key (選用，如需使用 Gemini)
# GOOGLE_API_KEY=your-google-api-key-here

# Admin Token (選用，用於保護管理 API)
# ADMIN_TOKEN=your-admin-token-here

# API 設定
# API_HOST=0.0.0.0
# API_PORT=8000
# API_RELOAD=True

# 日誌設定
# LOG_LEVEL=INFO

# ChromaDB 設定
# CHROMA_DB_PATH=./data/chroma_db
# CHROMA_COLLECTION_NAME=airpods_manual

# OpenAI 模型設定
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TEMPERATURE=0.3

# 文本處理設定
# CHUNK_SIZE=600
# CHUNK_OVERLAP=30
